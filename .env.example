# ---------------------------------------------------------------------------
# HospitalityOS AI — environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- App ---
ENVIRONMENT=development          # development | test | production
APP_SECRET_KEY=change-me-to-a-random-64-char-secret
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://hospitality:hospitality@localhost:5432/hospitality
DATABASE_URL_SYNC=postgresql+psycopg://hospitality:hospitality@localhost:5432/hospitality

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- LLM provider (provider-independent interface) ---
LLM_PROVIDER=mock                # mock | openai | anthropic | local
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=
LLM_BASE_URL=

# --- Embeddings ---
EMBEDDING_PROVIDER=mock           # mock | sentence-transformers | openai
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Vector store ---
VECTOR_STORE_PROVIDER=local       # local | pinecone  (local required for dev/test; never faked in prod)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX=hospitality-knowledge

# --- Twilio (WhatsApp) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_WEBHOOK_VALIDATE=true

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Storage ---
STORAGE_PROVIDER=local            # local | s3
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Observability ---
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
