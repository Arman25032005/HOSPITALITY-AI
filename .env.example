# ---------------------------------------------------------------------------
# HospitalityOS AI — environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- App ---
ENVIRONMENT=development          # development | test | production
APP_SECRET_KEY=change-me-to-a-random-64-char-secret
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://hospitality:hospitality@localhost:5432/hospitality
DATABASE_URL_SYNC=postgresql+psycopg://hospitality:hospitality@localhost:5432/hospitality

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- LLM provider (optional; provider-independent) ---
# none = deterministic paths only (rules + templates). The LLM is used only for ambiguous-intent
# classification, natural-language date extraction and conversation summaries, always as
# schema-validated structured output; it never writes replies or triggers actions.
# anthropic = official SDK (needs LLM_API_KEY or ANTHROPIC_API_KEY)
# openai-compatible = any /chat/completions server incl. local models (needs LLM_BASE_URL)
LLM_PROVIDER=none
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=20

# --- Conversations / agents ---
CONTEXT_WINDOW_MESSAGES=12
CONVERSATION_RETENTION_DAYS=90
PENDING_CONFIRMATION_TTL_MINUTES=15
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_CALLS=8
CHAT_SESSION_RATE_PER_MINUTE=30
CHAT_MESSAGE_RATE_PER_MINUTE=60
MAX_MESSAGE_CHARS=1000

# --- Embeddings ---
# hashing = deterministic lexical vectors for dev/test only (rejected in production)
EMBEDDING_PROVIDER=hashing        # hashing | sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Vector store ---
# local = vectors in Postgres, dev/test only. Production requires pinecone + API key.
VECTOR_STORE_PROVIDER=local       # local | pinecone
PINECONE_API_KEY=
PINECONE_INDEX=hospitality-knowledge

# --- RAG tuning ---
RAG_TOP_K=5
RAG_MIN_COVERAGE=0.5
RAG_MIN_COSINE=0.55
MAX_UPLOAD_BYTES=5242880

# --- Twilio (WhatsApp) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_WEBHOOK_VALIDATE=true

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Storage ---
STORAGE_PROVIDER=local            # local | s3
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Observability ---
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
